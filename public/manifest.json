{
    "manifest_version": 3,
    "name": "LinkedIn Call Extension",
    "version": "1.0",
    "description": "Call candidates via Plivo directly from LinkedIn",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Uplers Call Extension"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "assets/content.css"
            ]
        },
        {
            "matches": [
                "https://platform.uplers.com/app/*"
            ],
            "js": [
                "uplers.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/*"
            ],
            "matches": [
                "https://www.linkedin.com/*"
            ]
        }
    ]
}